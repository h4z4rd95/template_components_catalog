# deps & build output
node_modules/
.npm/
.npmrc.local

# framework build output (CI regenerates these into docs/ at deploy time)
.next/
.nuxt/
.output/
out/
dist/
build/
# `dist/` matches the *directory*; Nuxt's build also drops a `dist` symlink beside it, and a
# symlink is not a directory — it slipped past the rule above and was committed once, with an
# absolute path that only ever resolved on the machine that made it.
apps/*/dist
.turbo/
.vite/

# generated framework exports inside the Pages root — artifacts, never source
docs/framework/

# caches & logs
.cache/
*.log
coverage/
.DS_Store
.pytest_cache/
.ruff_cache/
__pycache__/

# typescript build info
*.tsbuildinfo
next-env.d.ts.bak

# env
.env
.env.local
.env.*.local

# scratch capture output during development
.shots/

# The downloadable source archive is produced by `npm run bundle` (and by every
# `npm run build`), so it is never committed — like docs/framework/**.
docs/download/*.zip
